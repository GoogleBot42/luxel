+/// The largest byte count one DMA descriptor covers — the chunking
+/// [`dma_descriptor_count`] and the chain builder use.
+///
+/// Luxel local patch (Gitea #460): public so a caller sizing its own
+/// descriptor slice for a non-default plane schedule can do the same
+/// arithmetic.
+#[must_use]
+pub const fn max_dma_chunk_size() -> usize {
+    MAX_DMA_CHUNK_SIZE
+}
+
+/// Luxel local patch (Gitea #460 / #789): per-plane repeat counts for the BCM
+/// descriptor chain. `0` = the stock count for that plane, `2^(planes − 1 −
+/// plane_idx)`; anything else is how many times that plane's row blocks are
+/// emitted per pass. Read by the chain builder ([`bcm`]) every time a ring is
+/// filled — at [`Hub75::new`] and at the first swap to a framebuffer — so set
+/// it BEFORE constructing the driver, and never change it while a driver is
+/// running: the descriptor slice's size, the ring stride and the frame-count
+/// ISR's pass arithmetic are all derived from the counts in force when the
+/// rings were built.
+///
+/// Why a static rather than a `FrameBuffer` method: the trait lives in
+/// `hub75-framebuffer` and the driver is a process singleton anyway (its ISR
+/// state is module statics).
+static PLANE_REPEATS: [core::sync::atomic::AtomicU8; bcm::MAX_PLANES] =
+    [const { core::sync::atomic::AtomicU8::new(0) }; bcm::MAX_PLANES];
+
+/// Luxel local patch (Gitea #460): install per-plane repeat counts for every
+/// ring built from now on. Entries past `reps.len()`, and `0` entries, keep
+/// the stock `2^(planes − 1 − plane_idx)`. See [`PLANE_REPEATS`].
+pub fn set_plane_repeats(reps: &[u8]) {
+    for (i, slot) in PLANE_REPEATS.iter().enumerate() {
+        slot.store(
+            reps.get(i).copied().unwrap_or(0),
+            core::sync::atomic::Ordering::Relaxed,
+        );
+    }
+}
+
+/// Luxel local patch (Gitea #460): the repeat count in force for
+/// `plane_idx` of a `plane_count`-plane framebuffer.
+#[must_use]
+pub fn plane_repeats(plane_count: usize, plane_idx: usize) -> usize {
+    let set = PLANE_REPEATS[plane_idx].load(core::sync::atomic::Ordering::Relaxed);
+    if set == 0 {
+        1usize << (plane_count - 1 - plane_idx)
+    } else {
+        usize::from(set)
+    }
+}
+
+/// Luxel local patch (Gitea #460): [`dma_descriptor_count`] under the repeat
+/// counts currently installed by [`set_plane_repeats`] — what
+/// `CircularBcmBuf::new` actually builds.
+#[must_use]
+pub fn dma_descriptor_count_scheduled(plane_count: usize, bcm_chunk_bytes: usize) -> usize {
+    assert!(
+        plane_count <= bcm::MAX_PLANES,
+        "plane_count exceeds MAX_PLANES"
+    );
+    let descs_per_chunk = bcm_chunk_bytes.div_ceil(MAX_DMA_CHUNK_SIZE);
+    let total_reps: usize = (0..plane_count).map(|p| plane_repeats(plane_count, p)).sum();
+    descs_per_chunk * total_reps
+}
