+/// Probe the DMA channel: `(current outlink descriptor address, an out_eof is
+/// raised and not yet cleared)` — GDMA `OUT_DSCR` and `OUT_INT_RAW.out_eof`.
+///
+/// Luxel local patch (Gitea #376). The frame-count ISR compares the address
+/// against the descriptor-ring ranges to tell whether an armed ring flip has
+/// landed; `swap` uses both halves to decide whether the next EOF is the
+/// switch or whether it has to wait for two.
+#[cfg(feature = "circular-dma")]
+fn gdma_probe() -> (usize, bool) {
+    let ch = GDMA_CHANNEL_NUM.load(core::sync::atomic::Ordering::Relaxed) as usize;
+    // SAFETY: read-only accesses to the descriptor-status and raw-interrupt
+    // registers of the channel this driver owns.
+    unsafe {
+        let dma = esp_hal::peripherals::DMA::steal();
+        let ch = dma.register_block().ch(ch);
+        let desc = ch.out_dscr().read().bits() as usize;
+        let eof_pending = ch.out_int().raw().read().out_eof().bit_is_set();
+        (desc, eof_pending)
+    }
+}
