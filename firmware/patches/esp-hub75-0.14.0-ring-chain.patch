+/// Luxel local patch (Gitea #856): descriptors [`fill_ring_chain`] writes for
+/// `slots` slots read in `emissions` emissions of `row_bytes` each — the
+/// same `MAX_DMA_CHUNK_SIZE` chunking as [`crate::dma_descriptor_count`].
+#[cfg(feature = "circular-dma")]
+#[must_use]
+pub const fn ring_descriptor_count(slots: usize, emissions: usize, row_bytes: usize) -> usize {
+    slots * emissions * row_bytes.div_ceil(MAX_DMA_CHUNK_SIZE)
+}
+
+/// Luxel local patch (Gitea #856): the ROW-MAJOR RING chain.
+///
+/// A circular descriptor chain over `slot_bases.len()` fixed slots. Each
+/// slot is a block of rows of `row_bytes` bytes; `order[e]` is the slot ROW
+/// the DMA reads on emission `e`, and every slot is read in that order — so
+/// a slot holding one row pair's planes emits `plane p` `reps(p)` times by
+/// listing its row `reps(p)` times, and the BCM repeats cost descriptors,
+/// not memory. Nothing here knows about planes: the caller decides the
+/// order (`luxel_hub75::ring::slot_emissions`) and refills slots behind the
+/// DMA (`luxel_hub75::ring::Ring`).
+///
+/// `suc_eof` is set on the last descriptor of every `eof_every`-th slot
+/// (`0` = only the last slot), so the `out_eof` ISR runs once per
+/// `eof_every` slots and always at the ring's wrap. The last descriptor's
+/// `next` points back at the first. Returns the descriptors written
+/// ([`ring_descriptor_count`]).
+///
+/// # Panics
+/// If `descriptors` is too short, or `slot_bases`/`order` is empty.
+#[cfg(feature = "circular-dma")]
+pub fn fill_ring_chain(
+    descriptors: &mut [DmaDescriptor],
+    slot_bases: &[*const u8],
+    row_bytes: usize,
+    order: &[u8],
+    eof_every: usize,
+) -> usize {
+    let total = ring_descriptor_count(slot_bases.len(), order.len(), row_bytes);
+    assert!(total > 0, "an empty ring");
+    assert!(
+        descriptors.len() >= total,
+        "not enough DMA descriptors for the ring: have {}, need {}",
+        descriptors.len(),
+        total,
+    );
+    let eof_every = if eof_every == 0 { slot_bases.len() } else { eof_every };
+    let base_ptr = descriptors.as_mut_ptr();
+    let mut idx = 0;
+    for (s, &slot) in slot_bases.iter().enumerate() {
+        let slot_eof = (s + 1) % eof_every == 0 || s + 1 == slot_bases.len();
+        for (e, &row) in order.iter().enumerate() {
+            let last_emission = e + 1 == order.len();
+            let mut remaining = row_bytes;
+            let mut offset = usize::from(row) * row_bytes;
+            while remaining > 0 {
+                let chunk = remaining.min(MAX_DMA_CHUNK_SIZE);
+                let is_last = idx + 1 == total;
+                let next = if is_last {
+                    base_ptr
+                } else {
+                    unsafe { base_ptr.add(idx + 1) }
+                };
+                let desc = &mut descriptors[idx];
+                // SAFETY: `slot` is the caller's live slot block and
+                // `offset` stays within `order.len()` rows of `row_bytes`.
+                desc.buffer = unsafe { slot.add(offset) as *mut u8 };
+                desc.set_size(chunk);
+                desc.set_length(chunk);
+                desc.set_owner(Owner::Dma);
+                desc.set_suc_eof(slot_eof && last_emission && remaining == chunk);
+                desc.next = next;
+                remaining -= chunk;
+                offset += chunk;
+                idx += 1;
+            }
+        }
+    }
+    total
+}
