+++ b/include/hw/xtensa/esp32s3_clk.h	2026-09-21 00:09:27.730493864 -0600
@@ -56,6 +56,9 @@
     /* Bitmap that keeps the level of the IRQs */
     uint32_t levels;
     
+    /* SYSTEM_CORE_1_CONTROL_0: APP-CPU runstall/clkgate/reset */
+    uint32_t core_1_control_0;
+
     uint32_t app_cpu_addr;
     
     uint32_t sys_ext_dev_enc_dec_ctrl;
